{
  "name": "qdenka/php-architecture-guardian",
  "description": "A tool for enforcing architectural principles in PHP projects",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Denis",
      "email": "denis@kaban.dev"
    }
  ],
  "require": {
    "php": "^8.1",
    "symfony/console": "^5.4|^6.0|^7.0",
    "symfony/finder": "^5.4|^6.0|^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5|^10.0|^11.0",
    "phpstan/phpstan": "^1.9|^2.0",
    "friendsofphp/php-cs-fixer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "PHPArchitectureGuardian\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PHPArchitectureGuardian\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/php-architecture-guardian"
  ],
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "cs-fix": "php-cs-fixer fix src",
    "cs-check": "php-cs-fixer fix src --dry-run --diff",
    "check-all": [
      "@test",
      "@phpstan",
      "@cs-check"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
